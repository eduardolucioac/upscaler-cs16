# Your own settings, copied from "config_model.bash". Not tracked: a pull
# must never overwrite your paths, and your paths must never reach a commit.
# The TEMPLATE is what git carries.
/config.bash

# Work in progress of an unfinished run. It is rebuilt from the maps and
# carries no information the scan cannot produce again.
__FAILSAFE__/

# Written as it runs; the last LOGS_KEEP_S of each are kept on disk.
logs/

# Python bytecode cache, rebuilt on every run.
__pycache__/
*.pyc

# Game screenshots, which is what the engine writes. They are the SOURCE of
# the before/after pictures - 12 MB each - and what belongs in the project
# is the finished pair, not the raw frames.
*.bmp

# Backup copies, the way "ez_smb_sync" does it. "images/upscaler-cs16_BAK.png"
# is the art before it was resized: 417 KB that no README points at, and
# neither sibling project carries an equivalent.
*_BAK
*_BAK.*
*.bak

# Editor and desktop leftovers.
.vscode/
*.swp
*~
.DS_Store

# NOTE: The libraries under "ez_i/" and "json-like/" are VENDORED - their
# FILES are versioned here so that a plain clone of this project has
# everything it needs, with no submodule to initialise.
#
# They are also working clones of their own repositories, so that they can be
# developed in place and pushed from here. Their ".git" folders never travel
# with this one: git treats that name as special and refuses to version it,
# whatever any rule says. Nothing has to be written here for that.
#
# The one thing to remember: a change to a library file lives in TWO
# repositories. Committing it in "ez_i/" alone leaves this project carrying
# the older copy, and nothing warns about it.
